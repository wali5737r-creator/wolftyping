/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Adsterra allowances (WolfTyping's own ad units, served from bauval.org):
  # script-src/connect-src/style-src +bauval.org for the two invoke scripts
  # and anything they fetch; frame-src (new) so the 728x90 unit's iframe may
  # load; img-src widened to https: because native-banner creative images are
  # served from rotating ad-network CDN domains (images only — scripts and
  # frames stay pinned to bauval.org).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com https://www.googletagmanager.com https://bauval.org https://*.bauval.org https://cdn.cloudvideosa.com; connect-src 'self' https://www.gstatic.com https://fonts.gstatic.com https://www.google-analytics.com https://region1.google-analytics.com https://bauval.org https://*.bauval.org https://cdn.cloudvideosa.com; worker-src 'self'; style-src 'self' 'unsafe-inline' https://bauval.org https://*.bauval.org https://cdn.cloudvideosa.com; img-src 'self' data: https:; media-src 'self' https://bauval.org https://*.bauval.org https://cdn.cloudvideosa.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://bauval.org https://*.bauval.org https://cdn.cloudvideosa.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# sqlite3.wasm (748,686 bytes) is fetched on every database open, so a
# repeat visit within the hour reuses it instead of re-downloading it.
# 1 hour + must-revalidate (not immutable): the file changes only when
# the drift/sqlite3 build changes, and a stale wasm must never outlive
# a deploy — revalidation keeps a new build safe.
# drift_worker.js is no longer fetched (see database_connection_web.dart).
/sqlite3.wasm
  Cache-Control: public, max-age=3600, must-revalidate

# Noto Nastaliq Urdu (690,304 bytes) is fetched on first Urdu paint, so a
# repeat visit reuses it instead of re-downloading it — on a slow
# connection a re-download leaves the Urdu passage blank for minutes.
# Served at /assets/assets/fonts/… (the pubspec asset path
# assets/fonts/… is served under build/web/assets/).
# 1 year + must-revalidate (not immutable): the file changes only when
# the font itself is swapped, and a stale font must never outlive a
# deploy — revalidation keeps a new build safe.
/assets/assets/fonts/*
  Cache-Control: public, max-age=31536000, must-revalidate
